<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme only, on purpose: the app is pure Compose (no
         AppCompat/Material Components dependency), so the manifest's
         android:theme just needs a valid framework parent to satisfy the
         resource linker before Compose's own MaterialTheme takes over. -->
    <style name="Theme.MotoNav" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
